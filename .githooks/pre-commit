#!/usr/bin/env bash
# Runs each project's own gates. A project is a top-level directory with an
# executable `check`; it runs when the commit touches that directory, or always
# with --all. Enable per clone with: git config core.hooksPath .githooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

failed=0

for check in */check; do
  [[ -x $check ]] || continue
  project=${check%/check}
  if [[ ${1-} != --all ]] && git diff --cached --quiet -- "$project"; then
    continue
  fi
  echo "== $project"
  "$check" || failed=1
done

if [[ $failed -ne 0 ]]; then
  echo
  echo "commit aborted (bypass with: git commit --no-verify)" >&2
  exit 1
fi
