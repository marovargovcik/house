#!/usr/bin/env bash
# Every gate for roof/: formatting, lint, types, tests, and the browser page.
# The root pre-commit hook runs this when a commit touches roof/.
set -uo pipefail
cd "$(dirname "$0")"

failed=0

uv run ruff format --check . || { echo "  -> fix: uv run ruff format ."; failed=1; }
uv run ruff check .          || { echo "  -> fix: uv run ruff check --fix ."; failed=1; }
uv run mypy .                || failed=1
uv run pytest -q             || failed=1

# Browser page: lint, format, types. Skipped loudly without node_modules,
# which `uv sync` doesn't install.
if [[ -d web/node_modules ]]; then
  npm --prefix web run --silent check \
    || { echo "  -> fix: npm --prefix web run format, then re-check"; failed=1; }
else
  echo "note: skipping web checks (run: npm --prefix web install)"
fi

exit $failed
